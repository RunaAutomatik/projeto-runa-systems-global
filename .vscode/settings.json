{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.netlify": true,
    "**/.venv": true,
    "**/.aiox-core/node_modules": true,
    "**/.aiox-core/local": true,
    "**/node_modules": true,
    "**/node_modules/**": true,
    "**/.next": true,
    "**/.gstack": true,
    "**/graphify-out": true,
    "**/.tmp": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.next/**": true,
    "**/.netlify/**": true,
    "**/.venv/**": true,
    "**/.aiox-core/**": true,
    "**/.gstack/**": true,
    "**/graphify-out/**": true,
    "**/.tmp/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.next": true,
    "**/.netlify": true,
    "**/.venv": true,
    "**/.aiox-core": true,
    "**/.gstack": true,
    "**/graphify-out": true,
    "**/.tmp": true
  },
  "typescript.tsserver.maxTsServerMemory": 2048,
  "json.maxItemsComputed": 5000
}
